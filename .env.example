# ==============================================================================
# MAIS LTD LIVESTOCK MANAGEMENT SYSTEM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# RUNTIME CONFIGURATION
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"

# INITIAL ADMIN PASSWORD
# Set this to a strong password before first boot. The server hashes it with SHA-256 on startup.
INITIAL_ADMIN_PASSWORD=""

# SUPABASE / POSTGRESQL CONFIGURATION
# Connects the application to your Supabase project for Authentication, Authorization, and PostgreSQL persistence
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Direct PostgreSQL connection string (SSL enforced via sslmode=require) used by migration runner / backup dumps:
SUPABASE_DB_URL=""

# BACKUP ENCRYPTION
# 32+ character secret passphrase used to derive the 256-bit AES-256-GCM encryption key for backups:
BACKUP_ENCRYPTION_KEY=""
